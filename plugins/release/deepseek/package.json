{
  "name": "@ai-freer/html-to-wechat",
  "version": "0.2.1",
  "description": "把同一份 HTML 交付为公众号富文本、小红书图集、口播稿或飞书文档的 DeepSeek Harness 技能插件",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ai-freer/html-to-wechat.git",
    "directory": "plugins/release/deepseek"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "wechat",
    "xiaohongshu",
    "feishu",
    "html"
  ],
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.png",
    "./package.json": "./package.json"
  },
  "icon": "./icon.png",
  "files": [
    "LICENSE",
    "index.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.png",
    "skills"
  ],
  "engines": {
    "node": ">=20.19",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "cheerio": "^1.0.0",
    "jsdom": "^25.0.1",
    "juice": "^10.0.0",
    "turndown": "^7.2.0"
  }
}
